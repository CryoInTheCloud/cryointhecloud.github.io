etabyte catalog of satellite imagery and geospatial raster datasets with planetary-scale analysis capabilities. It provides an easy, unified way to query for raster data that can help you put ICESat-2 data into context. Earth Engine is available for commercial use, but remains free for academic and research use.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"i6rLFjh6pp"}],"key":"rGinW56ZdQ"},{"type":"heading","depth":2,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Do I need to register for a Google Earth Engine account?","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"lOuiP7AsWE"}],"identifier":"do-i-need-to-register-for-a-google-earth-engine-account","label":"Do I need to register for a Google Earth Engine account?","html_id":"do-i-need-to-register-for-a-google-earth-engine-account","implicit":true,"key":"GMb3AQNYZP"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"The ICESat-2 visualization tutorial will have an interactive component that uses GEE to query for additional data that can help you put your ICESat-2 data into context.\nIf you would like to follow this part of the tutorial interactively, you will need to have registered for an account so that you can authenticate GEE.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"jfmFMkzR7X"}],"key":"qphjwSqWEV"},{"type":"heading","depth":2,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Registering for an Earth Engine account","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"urniCvxjeq"}],"identifier":"registering-for-an-earth-engine-account","label":"Registering for an Earth Engine account","html_id":"registering-for-an-earth-engine-account","implicit":true,"key":"eqMxg8UNl5"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":14,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"Go the the ","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"v7PMaZtrnS"},{"type":"link","url":"https://signup.earthengine.google.com/","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"GEE sign up page","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"Y9Ra2jYxqt"}],"urlSource":"https://signup.earthengine.google.com/","key":"iHErc6SoOK"},{"type":"text","value":" and enter the email you want to use for your GEE account. A gmail - or an institutional address with an associated google account - is best if you have one.","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"xh1i0fJoNQ"}],"key":"aHt0DRy9rV"},{"type":"listItem","spread":true,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Enter your email, your affiliation and country/region. Where it asks what you want to accomplish, mention you are at ICESat-2 Hackweek at the University of Washington.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"eatBxQpT5q"}],"key":"Q92Y82Ox2M"},{"type":"listItem","spread":true,"position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"Review the terms, verify your non-robot identify and click ‘Submit’.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"H6QS1tstcF"}],"key":"QrCR8wROGr"},{"type":"listItem","spread":true,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Check your email, including your spam folder, for a link from the Google Developer’s Team. The confirmation email will have directions on how to access the Code Editor.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"eqygjY6JMr"}],"key":"BayLfvf4pl"},{"type":"listItem","spread":true,"position":{"start":{"line":18,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Not sure if you have access? Use ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"u8azJ7Llzk"},{"type":"link","url":"https://code.earthengine.google.com/","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"this link","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"I38pR594fm"}],"urlSource":"https://code.earthengine.google.com/","key":"oJqkp4fP8N"},{"type":"text","value":" to check. If you didn’t get access you will get an authorization error that says your account isn’t registered. If you do have access, the link will open up the Javascript IDE. This link is your permanent portal to GEE access.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"e4T7DOK9cJ"}],"key":"FTf8uNEbR7"}],"key":"yBHCjjGeAr"},{"type":"image","url":"/build/gee-signup-a8937c0e75af4e454dec1969614fca6d.jpeg","alt":"gee-signup","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"vGF2fu38W5","urlSource":"../../img/gee-signup.jpeg","urlOptimized":"/build/gee-signup-a8937c0e75af4e454dec1969614fca6d.webp"}],"key":"x0jHgdj0C8"}],"key":"ath03s6rWt"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Earthdata Login","url":"/earthdata","group":"CryoCloud"},"next":{"title":"Software Carpentry Training","url":"/swc","group":"CryoCloud"}}},"domain":"http://localhost:3000"}