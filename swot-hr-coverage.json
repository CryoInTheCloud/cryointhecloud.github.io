ns and as different file types; because this tutorial downloads the orbit files directly from the source locations, the HR comes as a KML and LR orbit as a KMZ. A KMZ file is just a zipped version of KML that can typically be read by the same programs designed to read KML files (e.g., Fiona, Google Earth).","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"HTPKFyL4rH"}],"key":"BcG3MwsWNG"}],"class":"dropdown","key":"rzpKsmk0VV"}],"key":"uYMj26dYLK"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Package imports and data paths needed to get started","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"T6h7QenNda"}],"identifier":"package-imports-and-data-paths-needed-to-get-started","label":"Package imports and data paths needed to get started","html_id":"package-imports-and-data-paths-needed-to-get-started","implicit":true,"key":"WgoL4yCytG"}],"key":"khpu1Q9gR5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"%matplotlib widget\n\nfrom pathlib import Path\nimport io, zipfile, tempfile, os\nimport warnings\nimport requests\nimport fiona\nimport geopandas as gpd\nimport pandas as pd\nimport matplotlib.pyplot as plt\nfrom matplotlib.colors import to_rgba\nfrom matplotlib.patches import Patch\nimport cartopy.crs as ccrs\n\n# Quiet noisy driver warnings (optional)\nwarnings.filterwarnings(\"ignore\", message=\".*ERROR parsing kml Style: No id.*\", category=RuntimeWarning)","key":"yCFDo6OfuX"},{"type":"outputs","id":"HkAYxw3LAj-kXgR1H01WE","children":[],"key":"nrjERJwRUS"}],"key":"T70zjnBUHH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# --- Paths ---\n\n# Make DATADIR, a folder to hold downloaded datasets\nDATADIR = Path(\"/home/jovyan/shared/SWOT/data\")  # adjust if needed, e.g., running locally\nDATADIR.mkdir(parents=True, exist_ok=True)\n\n# CryoCloud file targets\nGL_SHP = DATADIR / \"Antarctica_masks\" / \"scripps_antarctica_polygons_v1.shp\" # Basemap\nHR_KML = DATADIR / \"hr_Mar2025_below60S.kml\"   # HR KML\nLR_KMZ = DATADIR / \"lr_Sept2015.kmz\"           # LR KMZ\n\n# Source URLs [Try replacing with different versions]\nHR_URL = \"https://podaac.jpl.nasa.gov/SWOT-events/swot_science_hr_Mar2025-v10_perPass.kml\" \nLR_URL = \"https://www.aviso.altimetry.fr/fileadmin/documents/missions/Swot/swot_science_orbit_sept2015-v2_10s.kmz\"\n\n# Scripps polygons zip (contains multiple shapefile components)\nGL_ZIP_URL = \"https://doi.pangaea.de/10013/epic.42133.d001\"\n\n# Bach Ice Shelf bounding box location in South Polar Stereographic [ESPG: 3031]\nbach = [-1920000, 480000, -1740000, 680000]","key":"eDfA0SrS1j"},{"type":"outputs","id":"yVJwF-liAcVfVarSKJLGx","children":[],"key":"Du0yeAdNVl"}],"key":"BCGr4PPgbg"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Data read-in helper functions","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EEzOb8LkgM"}],"key":"qCMhPLVMld"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"download_bytes","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"dQW97n5flM"},{"type":"text","value":" Robust HTTP downloads with timeouts","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"OZCnXuFr7p"}],"key":"DIq0XRLFAW"}],"key":"HhY8RFnMsO"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ensure_scripps_polygons","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"PuiTOxBgRw"},{"type":"text","value":" Fetches and unzips the Scripps shapefiles if missing","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"XUsIUQhVfj"}],"key":"mYRY5RAge1"}],"key":"hvqCFeDZ6X"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"read_all_kml_layers","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"CQruiiF6mA"},{"type":"text","value":" Merges all non-empty KML/KMZ layers into one GeoDataFrame","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Ybk9PFgaDW"}],"key":"PWAUz4LfXA"}],"key":"FcomIIc2rt"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"save_kml","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"ZUKsdnx6aa"},{"type":"text","value":" Writes a KML for quick reuse","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"fY8ctOmXqR"}],"key":"VXby1rhmPH"}],"key":"w2FHquIouY"}],"key":"JbbWvvbWW8"}],"class":"tip","key":"ETOr9PFqUr"}],"key":"sdbUlu6dau"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# --- Data read-in elper functions ---\ndef download_bytes(url: str) -> bytes:\n    r = requests.get(url, timeout=180)\n    r.raise_for_status()\n    return r.content\n\ndef ensure_scripps_polygons(gl_shp_path: Path, source_zip_url: str) -> None:\n    \"\"\"Download & extract the Scripps Antarctica polygons if missing.\"\"\"\n    if gl_shp_path.exists():\n        return\n    gl_shp_path.parent.mkdir(parents=True, exist_ok=True)\n    print(\"Downloading Scripps Antarctica polygons…\")\n    content = download_bytes(source_zip_url)\n    with zipfile.ZipFile(io.BytesIO(content)) as zf:\n        zf.extractall(gl_shp_path.parent)\n    print(f\"Extracted to: {gl_shp_path.parent}\")\n\ndef read_all_kml_layers(path: Path, driver=\"KML\") -> gpd.GeoDataFrame:\n    \"\"\"Load all non-empty KML/KMZ layers into a single GeoDataFrame.\"\"\"\n    layers = fiona.listlayers(str(path))\n    frames = []\n    for lyr in layers:\n        try:\n            gdf = gpd.read_file(path, driver=driver, layer=lyr)\n            if not gdf.empty:\n                frames.append(gdf)\n        except Exception as exc:\n            print(f\"Skipped layer '{lyr}': {exc}\")\n    if not frames:\n        raise RuntimeError(f\"No valid layers in {path}\")\n    return gpd.GeoDataFrame(pd.concat(frames, ignore_index=True))\n\ndef save_kml(gdf: gpd.GeoDataFrame, out_path: Path) -> None:\n    \"\"\"Save a GeoDataFrame as KML (for future reuse).\"\"\"\n    out_path.parent.mkdir(parents=True, exist_ok=True)\n    gdf.to_file(out_path, driver=\"KML\")","key":"uPClcIesPN"},{"type":"outputs","id":"e7xpgrFK1y1weXUzh8R-e","children":[],"key":"MBLVkS2haF"}],"key":"LPNUS1Eokt"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Read the Scripps Antarctic basemap","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"F9ZLCgxc3N"}],"key":"cWPv6uf3sL"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Auto download the file if not already present (We did this for you on CryoCloud, but provide code for re-download or local use).","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ti6f8oK1bs"}],"key":"dCbmXwF16P"}],"key":"df6BDYYJ3K"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Load the Scripps polygons and reproject to EPSG:3031.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"a2S5VDHHRW"}],"key":"cxGyy3O1tG"}],"key":"j186m4q3Xi"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Split ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"QpCqvx1n7L"},{"type":"strong","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"grounded ice","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"XDky06ASHv"}],"key":"iW3FL6RUF9"},{"type":"text","value":" and ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"ZYgRxosmMw"},{"type":"strong","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"ice shelves","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"XHIhnzWHT8"}],"key":"hVNZUhTZyK"},{"type":"text","value":" for map styling.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"KmgdahI1qC"}],"key":"HVZD1dHkEm"}],"key":"FloXqvLgKa"}],"key":"A7I6zVi2xm"}],"key":"RpydtXm8z4"}],"key":"izpayZNfhn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Ensure basemap (Scripps polygons) is available\nensure_scripps_polygons(GL_SHP, GL_ZIP_URL)\n\n# Load and prep Scripps polygons\ngl_gdf = gpd.read_file(GL_SHP)\n# Reproject to EPSG:3031 (Antarctic Polar Stereographic)\ngl_gdf_3031 = gl_gdf.to_crs(epsg=3031)\n\n# Split polygons containing grounded ice vs ice shelves\nname_field = \"Id_text\" if \"Id_text\" in gl_gdf_3031.columns else None\nif name_field is None:\n    # Fall back to plotting all polygons uniformly if classification is missing\n    grounded_3031 = gl_gdf_3031\n    shelves_3031 = gpd.GeoDataFrame(geometry=[])\nelse:\n    # Split polygons by class\n    grounded_classes = {\"Grounded ice or land\", \"Isolated island\", \"Ice rise or connected island\"}\n    grounded_3031 = gl_gdf_3031[gl_gdf_3031[name_field].isin(grounded_classes)]\n    shelves_3031  = gl_gdf_3031[gl_gdf_3031[name_field] == \"Ice shelf\"]","key":"tCM9Eggs0n"},{"type":"outputs","id":"7cMTRk0VQ_1f_SsYbnc5R","children":[],"key":"kQJ9nQk3kq"}],"key":"zzcrvWK6Fo"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Ensure culled HR coverage file exists","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SIkda33Vsa"}],"key":"YCCvPP5AoU"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We cull the HR mask south of 60°S to speed up plotting by removing HR regions not relevant to Antarctica (We already did this for you on CryoCloud, but provide code for trying different versions of the HR mask).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ojpmY9cVry"}],"key":"kGixxbLz2k"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":5,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Download the HR orbital file to a temporary location where it deletes as soon as we leave the for loop, minimizing memory usage","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Nz0qSELkpx"}],"key":"dZEyjvKEqf"}],"key":"Q8eH15yBt5"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Remove nadir features to only show swath coverage","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"m5z33pL8KD"}],"key":"OHpB9DvaGW"}],"key":"fgLkIJe7AN"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Save the culled HR KML locally as ","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"sYEXdoCb6m"},{"type":"inlineCode","value":"hr_Mar2025_below60S.kml","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"Owz9P69Wya"},{"type":"text","value":" so the next run is instant","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"lF3mqMe1p2"}],"key":"b8Iuumdhz1"}],"key":"Sc28JlqspB"}],"key":"NWavakav0W"}],"key":"vxOm2rVLVh"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"On culling the HR mask","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"cuzojetfiM"}],"key":"TpqxSotfIH"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"We are able to cull the HR mask to below 60°S because each segment of HR data is discontinuous from other segments even if they are part of the same pass, resulting in the ability to filter for segments using bounding box criteria. Because the LR orbit file is split by pass, each pass contains data below 60°S and cannot easily be culled in the same way. If you run the culling yourself it can take ~20 minutes on CryoCloud.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"COJaxJouUc"}],"key":"dJh2pYxXBf"}],"class":"dropdown","key":"vofGiqxbE0"}],"key":"PprOOqZij9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# --- Ensure SWOT HR coverage (culled to south of 60S) exists in CryoCloud ---\n# Note: This process takes ~20 min if not already completed\nif not HR_KML.exists():\n    for url in HR_URLS:\n        try:\n            # Download HR orbital file into temp\n            print(f\"Trying HR KML: {url}\")\n            with tempfile.TemporaryDirectory() as tdir:\n                kml_path = Path(tdir) / \"hr.kml\"\n                kml_path.write_bytes(download_bytes(url))\n            \n                hr_all = read_all_kml_layers(kml_path, driver=\"KML\") # with some KMZ/KML may need to use driver=\"LIBKML\"\n                hr_all = hr_all.assign(miny=hr_all.geometry.bounds.miny)\n                # Cull below 60 S\n                hr_south = hr_all[hr_all[\"miny\"] < -60].drop(columns=[\"miny\"])\n                if \"Name\" in hr_south.columns:\n                    # Remove nadir coverage to keep only KaRIn's\n                    hr_south = hr_south[~hr_south[\"Name\"].str.contains(\"Nadir\", na=False)]\n                save_kml(hr_south, HR_KML)\n            print(f\"Saved culled HR KML: {HR_KML}\")\n            break\n        except Exception as exc:\n            print(f\"Failed HR download/parse from {url}: {exc}\")\n    else:\n        raise RuntimeError(\"Could not obtain a usable SWOT HR KML.\")\n","key":"pXSaIGsWR6"},{"type":"outputs","id":"RirOzIcmgtb7PCnJNglh9","children":[],"key":"eL5FgxQkuj"}],"key":"nkgZdUqUcY"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Ensure LR Coverage File Exists","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OD36aST8nn"}],"key":"ylCeKktZTD"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The LR orbit is provided as KMZ. Most environments can read it via driver ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"xOkjL6QjyU"},{"type":"inlineCode","value":"\"KML\"","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Ec5VtY8z8g"},{"type":"text","value":".","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"LlegDn3e0D"}],"key":"bOpePdZOXl"}],"key":"WdDmOayP5e"}],"key":"Rwh0lnjx2v"}],"key":"fQaxV5Jmhd"}],"key":"uxpyNHaaJv"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# --- Ensure SWOT LR orbit exists in CryoCloud ---\nif not LR_KMZ.exists():\n    print(\"Downloading SWOT LR KMZ…\")\n    LR_KMZ.write_bytes(download_bytes(LR_URL))\n    print(f\"Saved: {LR_KMZ}\")","key":"FrbInw1yE5"},{"type":"outputs","id":"m4ix1kjfak0eWVQo2qX_c","children":[],"key":"ahXHFLQ2XP"}],"key":"BUpvP7twAL"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Load and reproject","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SkBxEEptX8"}],"key":"xqqQwxJzxt"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"We merge all HR and LR layers, and reproject both HR and LR GeoDataFrames to ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"sl4C1Tmq5X"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"EPSG:3031","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jKvXwGmGgc"}],"key":"KefKN9prJl"},{"type":"text","value":", the same projection as the Scripps Antarctic basemap.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"iCp7kGWYAd"}],"key":"b5aaU7x74x"}],"key":"HWGAkDctde"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Loading takes ~6 min because the LR file contains all 584 SWOT passes!","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"lTDJ34R09G"}],"key":"R7rZpuOgom"}],"key":"TffXHmxn0g"}],"key":"g3aWJGRqFE"}],"class":"tip","key":"fLZ0msEoeG"}],"key":"eU3ROxpEZs"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# --- Load HR/LR coverages and reproject to EPSG:3031 ---\n\n# HR (already culled), stored as KML\nhr_gdf = read_all_kml_layers(HR_KML, driver=\"KML\")\nhr_3031 = hr_gdf.to_crs(epsg=3031)\n\n# LR, stored as KMZ  \nlr_gdf = read_all_kml_layers(LR_KMZ, driver=\"KML\")\nif \"Name\" in lr_gdf.columns:\n    lr_gdf = lr_gdf[~lr_gdf[\"Name\"].str.contains(\"Nadir\", na=False)]\nlr_3031 = lr_gdf.to_crs(epsg=3031)\n\nlen(hr_3031), len(lr_3031)","key":"bUFTvnJEud"},{"type":"outputs","id":"1g0hjpQzlkW3UCUZkGGdR","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":7,"metadata":{},"data":{"text/plain":{"content":"(194, 584)","content_type":"text/plain"}}},"children":[],"key":"xv25sdw4aS"}],"key":"yEuFQQVLVG"}],"key":"TW1UkWotUk"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Plot coverage map","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"IwivNitBZP"}],"key":"Rh7KPiY7FS"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Basemap: Grounded ice in gray and ice shelves in light gray","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"IWWMB0u5R2"}],"key":"VM4ow2dAt9"}],"key":"zFaQ4bS6pu"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"SWOT LR","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"GrvDimOqs1"}],"key":"ANSuJtwxkp"},{"type":"text","value":" is shown in red; ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"EP15yls7tU"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"SWOT HR","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"vt9qbuRf0N"}],"key":"YUPDxcR4RO"},{"type":"text","value":" in blue","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"r658gZR40p"}],"key":"HE49MsFykF"}],"key":"eCLe1qfVEj"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"South Polar Stereographic is used for display and map is clipped to show Antarctica","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"Wg5xKTlxFX"}],"key":"UVzoCBWvpD"}],"key":"vDkOvDFOBL"}],"key":"rnPWRGlcEt"}],"key":"KQjmaR2IEb"}],"key":"YAEC8gFrnl"},{"type":"block","kind":"notebook-code","data":{"scrolled":true},"children":[{"type":"code","lang":"python","executable":true,"value":"# --- Plot availability over Antarctica (EPSG:3031) ---\nps71 = ccrs.Stereographic(central_latitude=-90, central_longitude=0, true_scale_latitude=-71)\n\nfig = plt.figure(figsize=(8, 8), dpi=110)\nax = plt.axes(projection=ps71)\n\n# Antarctica basemap: grounded vs shelves\ngrounded_3031.plot(ax=ax, transform=ps71, color=\"lightgray\", edgecolor=\"darkgray\", linewidth=0.3, zorder=1)\nshelves_3031.plot(ax=ax,   transform=ps71, color=\"gainsboro\", edgecolor=\"silver\", linewidth=0.25, zorder=2)\n\n# SWOT LR (red), SWOT HR (blue)\n# Build colors with different transparency for facecolor and edgecolor\nswot_hr_fill  = to_rgba(\"blue\", alpha=0.20)\nswot_hr_edge  = to_rgba(\"blue\", alpha=0.30)\nswot_lr_fill  = to_rgba(\"red\", alpha=0.06)\nswot_lr_edge  = to_rgba(\"red\", alpha=0.10)\n\n# Note: Many HR/LR geometries are polygons; we use both facecolor and edgecolor lightly\nlr_3031.plot(ax=ax, transform=ps71, color=swot_lr_fill, edgecolor=swot_lr_edge, linewidth=0.2, zorder=3)\nhr_3031.plot(ax=ax, transform=ps71, color=swot_hr_fill, edgecolor=swot_hr_edge, linewidth=0.2, zorder=4)\n\nbach_rect = plt.Rectangle((bach[0], bach[1]), bach[2] - bach[0], bach[3] - bach[1], \n                          zorder=5, linewidth=2, edgecolor=\"white\", facecolor=\"none\")\nax.add_patch(bach_rect)\n\n# Crop axes to Antarctica\nax.set_xlim(-3000000, 3000000) # 3000 km2\nax.set_ylim(-3000000, 3000000)\n\nlegend_handles = [\n    Patch(facecolor=\"gainsboro\", edgecolor=\"silver\", label=\"Ice shelves\"),\n    Patch(facecolor=\"lightgray\", edgecolor=\"darkgray\", label=\"Grounded ice / land\"),\n    Patch(facecolor=swot_lr_fill, edgecolor=swot_lr_edge, label=\"SWOT LR\"),\n    Patch(facecolor=swot_hr_fill, edgecolor=swot_hr_edge, label=\"SWOT HR\"),\n]\nleg = ax.legend(handles=legend_handles, loc=\"lower left\", frameon=True, framealpha=0.9)\nfor text in leg.get_texts():\n    text.set_fontsize(10)\n\nax.set_title(\"SWOT Availability over Antarctica (N. Hemisphere Summer)\", fontsize=14, pad=10)\n\nplt.tight_layout()\nplt.show()","key":"Qq1ao4bVLm"},{"type":"outputs","id":"xvRJKxdMxymZgGpWfO5Hk","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"application/vnd.jupyter.widget-view+json":{"content":"{\"model_id\":\"57ee9924cfa24142a6b9c10a4ab876ff\",\"version_major\":2,\"version_minor\":0}","content_type":"application/vnd.jupyter.widget-view+json"},"image/png":{"content_type":"image/png","hash":"a6c587d44579b1f0a5cedbf90e76639e","path":"/build/a6c587d44579b1f0a5cedbf90e76639e.png"},"text/html":{"content_type":"text/html","hash":"f872319d8f44b9f20416d17e74dda348","path":"/build/f872319d8f44b9f20416d17e74dda348.html"},"text/plain":{"content":"Canvas(toolbar=Toolbar(toolitems=[('Home', 'Reset original view', 'home', 'home'), ('Back', 'Back to previous …","content_type":"text/plain"}}},"children":[],"key":"cDW661kM7R"}],"key":"rR7TuC2pLU"}],"key":"rXMX8kUDib"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Summary","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"p81tgpJxbb"}],"key":"eupdE8Xlsy"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"We can see that HR coverage is limited to certain regions around Antarctica, while LR coverage is extensive to 78","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"FIXXxhEH13"},{"type":"text","value":"°","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"uXAKgWVCyA"},{"type":"text","value":" south, and also covers HR regions. In the next tutorials, we will focus on the Bach Ice Shelf region and compare HR data with ICESat-2 surface elevations, and then HR data with LR data.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"imRcAfrTMe"}],"key":"p3bQ9Q8izh"}],"key":"nGY5v5us6J"}],"key":"yQkAIX6cv4"}],"key":"qQTG7Bdjb6"},"references":{"cite":{"order":["https://doi.org/10.1594/pangaea.819147"],"data":{"https://doi.org/10.1594/pangaea.819147":{"label":"https://doi.org/10.1594/pangaea.819147","enumerator":"1","doi":"10.1594/PANGAEA.819147","html":"Depoorter, M. A., Bamber, J. L., Griggs, J., Lenaerts, J. T. M., Ligtenberg, S. R. M., van den Broeke, M. R., & Moholdt, G. (2013). <i>Antarctic masks (ice-shelves, ice-sheet, and islands), link to shape file</i>. PANGAEA. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1594/PANGAEA.819147\">10.1594/PANGAEA.819147</a>","url":"https://doi.org/10.1594/PANGAEA.819147"}}}},"footer":{"navigation":{"prev":{"title":"SWOT High Resolution data search and access","url":"/swot-lrhr-access","group":"StratusGeo"},"next":{"title":"Comparing SWOT HR Elevation to ICESat-2","url":"/swot-hr-vs-icesat2","group":"StratusGeo"}}},"domain":"http://localhost:3000"}